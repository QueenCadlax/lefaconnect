{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "lefa-connect",
	"compatibility_date": "2026-08-20",
	"main": ".output/server/index.mjs",
	"assets": {
		"directory": ".output/public",
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "lefa-connect-db",
			"database_id": "a9eb1bc8-1b96-4af0-86cc-257cbe08c84c",
			"migrations_dir": "migrations",
		},
	],
	"r2_buckets": [
		{
			"binding": "R2",
			"bucket_name": "lefa-connect-storage",
			"preview_bucket_name": "lefa-connect-storage-preview",
		},
	],
	"vars": {
		"BETTER_AUTH_URL": "https://lefa-connect.qcadlax.workers.dev",
	},
}